# Copy to deploy/.env with deploy/install.sh, then fill every value.

# Build metadata.
# git -C ~/projects/heliolytics rev-parse HEAD
HELIOLYTICS_COMMIT=
# git -C ~/projects/heliolytics-web rev-parse HEAD
HELIOLYTICS_WEB_COMMIT=
# date -u +%Y-%m-%dT%H:%M:%SZ
HELIOLYTICS_BUILT_AT=

# Database passwords, distinct.
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
APP_DB_PASSWORD=

# API signing keys.
# printf 'web.%s\n' "$(openssl rand -hex 32)"
HELIOLYTICS_WEB_API_KEY=
# printf 'phone.%s\n' "$(openssl rand -hex 32)"
HELIOLYTICS_PHONE_API_KEY=

# Web session secret.
# openssl rand -hex 32
HELIOLYTICS_SESSION_SECRET=

# Web login password hash.
# cd ~/projects/heliolytics-web && npm run auth:hash-password
# Keep the result on one line in single quotes:
# 'scrypt$N=32768$r=8$p=3$<32-hex-salt>$<64-hex-hash>'
HELIOLYTICS_WEB_PASSWORD_HASH=

# Cloudflare Zero Trust tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback-only published ports.
API_PORT=8080
WEB_PORT=3000
ADMINER_PORT=8081

# Trust only the connector address on the ingress network.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=172.28.0.10/32
COOKIE_SECURE=true

# Network layout. DATA_SUBNET must match deploy/pg_hba.conf.
DATA_SUBNET=172.30.0.0/24
INGRESS_SUBNET=172.28.0.0/24
CLOUDFLARED_IP=172.28.0.10

RATE_LIMIT_PER_MIN=120
RATE_LIMIT_PER_KEY_PER_MIN=600
REQUEST_TIMEOUT_SECONDS=90
MAX_CONCURRENT_BODY_READS=2

# Image tags.
API_IMAGE=heliolytics-api:deploy
WEB_IMAGE=heliolytics-web:deploy
