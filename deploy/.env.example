# Heliolytics deploy/.env template.
#
# Create the real file with deploy/install.sh, which copies this template to
# deploy/.env mode 0600 and stops. Every value below is empty or a placeholder
# on purpose: deploy/validate-env.sh rejects this file until you fill real values.
#
# Format rules enforced by deploy/validate-env.sh:
#   * "64 lowercase hex" means openssl rand -hex 32.
#   * HELIOLYTICS_WEB_PASSWORD_HASH is one line and the whole value is single-quoted:
#       HELIOLYTICS_WEB_PASSWORD_HASH='scrypt$N=32768$r=8$p=3$<32-hex-salt>$<64-hex-hash>'
#     Generate it in the heliolytics-web checkout with: npm run auth:hash-password
#     An unquoted or double-quoted hash lets Compose expand the $ bytes and breaks login.
#   * Never reuse one value in two fields.

# Nonsecret build metadata. Required for a production build.
HELIOLYTICS_COMMIT=
HELIOLYTICS_WEB_COMMIT=
HELIOLYTICS_BUILT_AT=

# Database credentials. POSTGRES_PASSWORD is the schema owner, APP_DB_PASSWORD the API role.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# API signing keys: exactly one web key (GET only) and one phone key (read and write).
HELIOLYTICS_API_KEYS=
# The web container receives only its own web key from the ring above.
HELIOLYTICS_API_KEY=

# Web login and session. The API never receives these two values.
HELIOLYTICS_SESSION_SECRET=
HELIOLYTICS_WEB_PASSWORD_HASH=

# Cloudflare tunnel token. Only used when the tunnel profile is started.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback-only published ports.
API_PORT=8080
WEB_PORT=3000
ADMINER_PORT=8081

# Proxy and client IP policy. Production requires isolated, cloudflared-only ingress.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=
COOKIE_SECURE=true

# Network layout. DATA_SUBNET must match the host lines in deploy/pg_hba.conf.
DATA_SUBNET=172.30.0.0/24
INGRESS_SUBNET=172.28.0.0/24
CLOUDFLARED_IP=172.28.0.10

# Request limits.
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_PER_KEY_PER_MIN=600
REQUEST_TIMEOUT_SECONDS=90
MAX_CONCURRENT_BODY_READS=2

# Optional local image tags.
API_IMAGE=heliolytics-api:deploy
WEB_IMAGE=heliolytics-web:deploy
