# deploy/install.sh copies this file to deploy/.env and fills every empty secret.
# To fill a value by hand, use the command shown above it.

# Compose project. The database volume is <project>_pgdata.
COMPOSE_PROJECT_NAME=heliolytics

# Written by deploy/deploy.sh and deploy/deploy-all.sh on every deploy.
HELIOLYTICS_COMMIT=
HELIOLYTICS_WEB_COMMIT=
HELIOLYTICS_BUILT_AT=

# Database passwords, distinct.
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
APP_DB_PASSWORD=

# API signing keys. The phone app signs uploads with the phone key.
# printf 'web.%s\n' "$(openssl rand -hex 32)"
HELIOLYTICS_WEB_API_KEY=
# printf 'phone.%s\n' "$(openssl rand -hex 32)"
HELIOLYTICS_PHONE_API_KEY=

# Web session secret.
# openssl rand -hex 32
HELIOLYTICS_SESSION_SECRET=

# Web login password hash, on one line in single quotes.
# cd ../heliolytics-web && npm run auth:hash-password
# HELIOLYTICS_WEB_PASSWORD_HASH='scrypt$N=32768$r=8$p=3$<salt>$<hash>'
HELIOLYTICS_WEB_PASSWORD_HASH=

# Cloudflare Zero Trust tunnel token, used by deploy/deploy-cloudflare.sh.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback-only published ports.
API_PORT=8080
WEB_PORT=3000
ADMINER_PORT=8081

# The API trusts client addresses forwarded by the tunnel connector only.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=172.28.0.10/32
COOKIE_SECURE=true

# Network layout. DATA_SUBNET must match deploy/pg_hba.conf.
# CLOUDFLARED_IP must sit inside INGRESS_SUBNET and match TRUSTED_PROXY_CIDRS.
DATA_SUBNET=172.30.0.0/24
INGRESS_SUBNET=172.28.0.0/24
CLOUDFLARED_IP=172.28.0.10

RATE_LIMIT_PER_MIN=120
RATE_LIMIT_PER_KEY_PER_MIN=600
REQUEST_TIMEOUT_SECONDS=90
MAX_CONCURRENT_BODY_READS=2

# Image tags.
API_IMAGE=heliolytics-api:deploy
WEB_IMAGE=heliolytics-web:deploy
