# Heliolytics nightly backup configuration.
#
# Install as /etc/heliolytics/backup.env, mode 0600, owned by the deploy account.
# systemd reads this as an EnvironmentFile: one KEY=value per line, no quoting,
# no shell syntax and no command substitution. Nonsecret values only.
#
# The destination must be an existing reachable SSH alias and an absolute path
# inside a directory the deploy account owns on the remote side:
#   BACKUP_DESTINATION=heliolytics-backup:/volumes/backups/heliolytics
# The alias, private key and known_hosts live in the deploy account's ~/.ssh.

# Canonical deploy directory that owns .env and docker-compose.yml.
HELIOLYTICS_DEPLOY_DIR=/home/deploy/projects/heliolytics/deploy

# Private staging directory on this host, mode 0700, same filesystem as the dump.
BACKUP_DIR=/home/deploy/heliolytics-backups

# Existing reachable off-host destination, alias:/absolute/directory.
BACKUP_DESTINATION=

# Dated bundles older than this many days are pruned after a verified copy.
BACKUP_KEEP_DAYS=30

# Optional nonsecret commit recorded in each .info sidecar.
HELIOLYTICS_COMMIT=
