# Install as /etc/heliolytics/backup.env, mode 0600, owned by the deploy account.
# EnvironmentFile format: KEY=value, no quoting, shell syntax or secrets.

# Canonical deploy directory that owns .env and docker-compose.yml.
HELIOLYTICS_DEPLOY_DIR=/home/deploy/projects/heliolytics/deploy

# Private staging directory on this host, mode 0700, same filesystem as the dump.
BACKUP_DIR=/home/deploy/heliolytics-backups

# Existing SSH alias and absolute directory owned by the remote deploy account.
# Keep the alias, key and known_hosts in the deploy account's ~/.ssh.
BACKUP_DESTINATION=

# Dated bundles older than this many days are pruned after a verified copy.
BACKUP_KEEP_DAYS=30

# Optional nonsecret commit recorded in each .info sidecar.
HELIOLYTICS_COMMIT=
