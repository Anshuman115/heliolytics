{
  "purpose": "Fabricated 0x25 and 0x26 protocol boundary cases. These are generated bytes, not a strap capture, so they prove framing, version, mode and range handling only.",
  "record_layouts": {
    "0x25": "one version byte 0x02 per round, then 65-byte records: u32 little-endian epoch at 0, spo2raw at 4, 60 unknown bytes at 5",
    "0x26": "one version byte 0x02 per round, then 30-byte records: u32 little-endian epoch at 0, spo2 at 4, duration at 5, high[6] at 6, low[6] at 12, signalQuality[8] at 18, extend[4] at 26"
  },
  "spo2_encoding": "pct = spo2raw & 0x7f; bit 7 set means automatic, clear means manual; valid pct range is 70 through 100",
  "epoch": "1782122400 is 2026-06-22T10:00:00Z; 1782122460 is 2026-06-22T10:01:00Z",
  "files": [
