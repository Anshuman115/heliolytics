      "offsets": [0, 66],
      "description": "two 0x25 rounds: 0x62 manual 98 then 0xe2 automatic 98",
      "expected": { "rows": 2, "trailing_bytes": 0, "status": "accepted", "pcts": [98, 98], "modes": ["manual", "auto"] }
    },
    {
      "name": "sleep-two-rounds.bin",
