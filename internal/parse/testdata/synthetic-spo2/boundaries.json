      "description": "two 0x26 rounds carrying the known firmware placeholder payload",
      "expected": { "rows": 0, "dropped": 2, "trailing_bytes": 0, "status": "raw_only", "warning": "spo2_sleep_placeholder offset=1 count=2" }
    },
    {
      "name": "wrong-version.bin",
      "bytes": 66,
      "sha256": "efeb79d7e71d9772171d0044e286bdb832e49f71149535afa2b877cdb262e18d",
      "offsets": [0],
      "description": "0x25 round whose version byte is 3",
      "expected": { "error": "unsupported_version" }
    },
    {
      "name": "normal-trailing-fragment.bin",
      "bytes": 135,
      "sha256": "fb599ee10adacc0d256664796e96cb482cb6712e80869e758198bd334458b004",
      "offsets": [0, 66],
      "description": "two valid 0x25 rounds followed by three bytes that do not form a record",
      "expected": { "rows": 2, "trailing_bytes": 3, "status": "partial", "warning": "trailing_fragment offset=132 count=3" }
    }
  ],
  "hex_cases": [
